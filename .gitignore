# pyenv
#   For a library or package, you might want to ignore these files since the Python version is usually managed by the user.
#   For a project, you might want to include these files.
# .python-version

# pipenv
#   According to pypa/pipenv#1173, it is recommended not to commit or ignore setup.cfg
# .pipenv
# .pipenv-info

# poetry
#   Poetry uses pyproject.toml and poetry.lock. We recommend NOT to commit poetry.lock to the repository unless you are using an application.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
# poetry.lock

# pdm
#   PDM uses pyproject.toml and pdm.lock. We recommend NOT to commit pdm.lock to the repository unless you are using an application.
#   https://pdm.fming.dev/latest/usage/project/#commit-your-pdmlock-file-to-version-control
# pdm.lock

# PEP 582; used by e.g. github.com/pdm-project/pdm
